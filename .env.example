# --- Client (embarqué dans le bundle navigateur : clés publiques uniquement) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Serveur uniquement (Vercel > Settings > Environment Variables) ---
# NE JAMAIS préfixer ces clés par VITE_ : elles seraient exposées au navigateur.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fonctionnalités IA (assistant, revue de code, génération de brief)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
